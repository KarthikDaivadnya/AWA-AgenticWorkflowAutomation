# Server
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Anthropic (required for AI steps to run)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Storage mode: "local" (default, no AWS needed) or "aws"
STORAGE_MODE=local or aws

# AWS (only needed if STORAGE_MODE=aws) — see /aws/README.md
AWS_REGION=ap-south-1
S3_BUCKET_NAME=agentic-workflow-uploads
DYNAMODB_TABLE_NAME=agentic-workflow-table
